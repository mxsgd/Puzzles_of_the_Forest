{
	"nodes":[
		{"id":"g-hab","type":"group","x":-1400,"y":1600,"width":3800,"height":1500,"color":"4","label":"Habitats & Scoring"},
		{"id":"g-steam","type":"group","x":4200,"y":-100,"width":1300,"height":2100,"color":"1","label":"Road to Steam"},
